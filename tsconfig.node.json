{
  "extends": "@tsconfig/node24/tsconfig.json",
  "compilerOptions": {
    "paths": {
      "~/*": ["./*"]
    },
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "test/*.ts",
    "test/unit/**/*.ts",
    "scripts/**/*.ts",
    "plugins/**/*.ts",
    "nitro.config.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "drizzle.config.ts"
  ]
}
