# Postgres connection for drizzle-kit CLI (db:generate / db:migrate / db:studio)
# and for `pnpm dev` when the dev database is disabled (NITRO_DRIZZLE_DEV_MOCK=false).
# Defaults match docker-compose.dev.yml (`pnpm docker:up`); `pnpm dev` itself runs
# on an in-memory PGlite dev database by default and needs no Postgres.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=user
POSTGRES_PASSWORD=passwd
POSTGRES_DB=mydb

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:20397
