# Local `pnpm dev:prod` — compose.dev.yaml publishes Postgres on localhost:5433.
# These five values expand into the drizzle.connection {{...}} templates
# (experimental.envExpansion) and have no fallbacks — every real-Postgres
# run needs them. `docker compose up` overrides host/port inside the app
# container to reach the postgres service. `pnpm dev:prod` sets
# NITRO_DRIZZLE_DEV=false to use this Postgres instead of the in-memory dev
# database that `pnpm dev` runs on.
NITRO_DRIZZLE_CONNECTION_USER=user
NITRO_DRIZZLE_CONNECTION_PASSWORD=passwd
NITRO_DRIZZLE_CONNECTION_HOST=localhost
NITRO_DRIZZLE_CONNECTION_PORT=5433
NITRO_DRIZZLE_CONNECTION_DATABASE=mydb
APP_PORT=3000

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Vite dev (`pnpm dev` / `pnpm dev:prod`) listens on 20398.
BETTER_AUTH_URL=http://localhost:20398
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:20398

# Compose deploy public origin. Unset defaults to http://localhost:3000 so
# BETTER_AUTH_URL above is not inherited by `docker compose up`.
# For a real host: APP_ORIGIN=https://example.com
# APP_ORIGIN=

# Required for any non-localhost public host (comma-separated).
# Example: example.com,example.com:*
BETTER_AUTH_ALLOWED_HOSTS=
