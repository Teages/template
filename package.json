{
  "name": "nuxt-app",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "nuxt typecheck",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "auth:generate": "better-auth generate --config ./server/utils/auth.ts --output ./server/database/auth.ts",
    "schema:update": "pnpm exec nuxt prepare",
    "task:db:reset": "curl -sf -X POST 'http://localhost:20397/_nitro/tasks/db:reset'",
    "validate:schema": "node --input-type=module -e \"import { readFileSync } from 'node:fs'; import { parse } from 'graphql'; parse(readFileSync(new URL('./server/graphql/schema.graphql', import.meta.url), 'utf8'))\"",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:api": "vitest run --project api",
    "test:nuxt": "vitest run --project nuxt",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "skills:install": "skills experimental_install --agent universal",
    "docker:up": "docker compose -f docker-compose.dev.yml up -d",
    "docker:down": "docker compose -f docker-compose.dev.yml down"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.2",
    "@pothos/core": "4.13.1",
    "@pothos/plugin-drizzle": "0.18.0",
    "@pothos/plugin-relay": "4.7.1",
    "@pothos/plugin-simple-objects": "4.1.4",
    "@pothos/plugin-with-input": "4.1.5",
    "@teages/oh-my-graphql": "^0.1.4",
    "@vueuse/core": "^14.4.0",
    "better-auth": "1.7.2",
    "consola": "^3.4.2",
    "defu": "^6.1.7",
    "drizzle-orm": "1.0.0-rc.4",
    "es-toolkit": "^1.52.0",
    "gazania": "^0.15.4",
    "graphql": "^16.14.1",
    "graphql-yoga": "5.22.0",
    "nuxt": "npm:nuxt-nightly@5.0.0-29801588.e458891d",
    "ofetch": "^1.5.1",
    "postgres": "^3.4.9",
    "ufo": "^1.6.4",
    "vue": "^3.5.42",
    "vue-router": "^5.3.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@better-auth/test-utils": "1.7.2",
    "@electric-sql/pglite": "^0.5.8",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@iconify-json/lucide": "^1.2.128",
    "@iconify-json/simple-icons": "^1.2.94",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/icon": "^2.5.1",
    "@nuxt/test-utils": "^4.2.0",
    "@nuxt/ui": "4.11.0",
    "@playwright/test": "^1.62.1",
    "@teages/nitro-drizzle": "^0.3.1",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.5.0",
    "@vueuse/nuxt": "^14.4.0",
    "auth": "1.7.2",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^10.9.1",
    "h3-next": "npm:h3@2.0.1-rc.29",
    "happy-dom": "^20.12.2",
    "jiti": "^2.7.0",
    "nitro": "3.0.260610-beta",
    "skills": "^1.5.23",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.1.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
