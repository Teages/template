{
  "name": "app",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "jiti ./scripts/prepare.ts",
    "dev": "pnpm dev:mock",
    "dev:mock": "MOCK_DATABASE=true vite dev",
    "dev:prod": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "pnpm prepare && vue-tsc --build --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest run",
    "test:watch": "vitest --project unit",
    "test:unit": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "auth:generate": "better-auth generate --config ./server/utils/auth.ts --output ./server/database/auth.ts",
    "skills:install": "skills experimental_install --agent universal",
    "task:db:migrate": "curl -sf -X POST 'http://localhost:20398/_nitro/tasks/db:migrate'",
    "task:db:reset": "curl -sf -X POST 'http://localhost:20398/_nitro/tasks/db:reset'"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "catalog:better-auth",
    "@nuxt/ui": "catalog:ui",
    "@pinia/colada": "catalog:vue",
    "@pothos/core": "catalog:graphql",
    "@pothos/plugin-drizzle": "catalog:graphql",
    "@pothos/plugin-relay": "catalog:graphql",
    "@pothos/plugin-simple-objects": "catalog:graphql",
    "@pothos/plugin-with-input": "catalog:graphql",
    "@teages/oh-my-graphql": "catalog:graphql",
    "@trpc/client": "catalog:trpc",
    "@trpc/server": "catalog:trpc",
    "better-auth": "catalog:better-auth",
    "consola": "catalog:utilities",
    "devalue": "catalog:utilities",
    "drizzle-orm": "catalog:database",
    "gazania": "catalog:graphql",
    "graphql": "catalog:graphql",
    "graphql-yoga": "catalog:graphql",
    "ofetch": "catalog:utilities",
    "pinia": "catalog:vue",
    "postgres": "catalog:database",
    "tailwindcss": "catalog:ui",
    "zod": "catalog:utilities"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:eslint",
    "@better-auth/test-utils": "catalog:better-auth",
    "@electric-sql/pglite": "catalog:database",
    "@graphql-typed-document-node/core": "catalog:graphql",
    "@tsconfig/node24": "catalog:typescript",
    "@types/node": "catalog:typescript",
    "@types/pg": "catalog:database",
    "@vitejs/devtools": "catalog:vite",
    "@vitejs/devtools-kit": "catalog:vite",
    "@vitejs/devtools-vite": "catalog:vite",
    "@vitejs/devtools-vitest": "catalog:vite",
    "@vitejs/plugin-vue": "catalog:vite",
    "@vitest/ui": "catalog:vitest",
    "@vue/tsconfig": "catalog:vue",
    "auth": "catalog:better-auth",
    "drizzle-kit": "catalog:database",
    "eslint": "catalog:eslint",
    "get-port-please": "catalog:tooling",
    "jiti": "catalog:tooling",
    "nitro": "catalog:nitro",
    "skills": "catalog:tooling",
    "srvx": "catalog:nitro",
    "typescript": "catalog:typescript",
    "unhead": "catalog:vue",
    "vite": "catalog:vite",
    "vite-plugin-devtools-json": "catalog:vite",
    "vitest": "catalog:vitest",
    "vue": "catalog:vue",
    "vue-router": "catalog:vue",
    "vue-tsc": "catalog:vue"
  }
}
