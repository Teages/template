{
  "name": "nuxt-app",
  "type": "module",
  "private": true,
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.22.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "nuxt typecheck",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "auth:generate": "better-auth generate -y --config ./server/utils/auth.ts --output ./server/database/auth.ts && eslint --fix ./server/database/auth.ts",
    "schema:update": "node ./scripts/schema-update.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:api": "vitest run --project api",
    "test:nuxt": "vitest run --project nuxt",
    "test:e2e": "vitest run --project e2e",
    "skills:install": "pnpx skills@latest experimental_install --agent universal --force",
    "docker:up": "docker compose -f docker-compose.dev.yml up -d",
    "docker:down": "docker compose -f docker-compose.dev.yml down"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.14",
    "@pothos/core": "4.16.0",
    "@pothos/plugin-drizzle": "0.20.2",
    "@pothos/plugin-relay": "4.8.1",
    "@pothos/plugin-simple-objects": "4.1.4",
    "@pothos/plugin-with-input": "4.1.5",
    "@teages/oh-my-graphql": "^0.2.0",
    "@vueuse/core": "^15.0.0",
    "better-auth": "1.7.14",
    "consola": "^3.4.2",
    "defu": "^6.1.7",
    "drizzle-orm": "1.0.0-rc.5",
    "es-toolkit": "^1.53.0",
    "gazania": "^0.15.4",
    "graphql": "^16.14.1",
    "graphql-yoga": "6.0.1",
    "nuxt": "5.0.0-nightly",
    "ofetch": "^1.5.1",
    "postgres": "^3.4.9",
    "ufo": "^1.6.4",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@better-auth/test-utils": "1.7.14",
    "@electric-sql/pglite": "^0.5.13",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@iconify-json/lucide": "^1.2.148",
    "@iconify-json/simple-icons": "^1.2.101",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/icon": "^2.6.2",
    "@nuxt/nitro-server": "5.0.0-nightly",
    "@nuxt/test-utils": "^4.3.4",
    "@nuxt/ui": "4.12.0",
    "@playwright/test": "^1.64.1",
    "@teages/nitro-drizzle": "^0.4.4",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "@vue/test-utils": "^2.5.1",
    "@vueuse/nuxt": "^15.0.0",
    "auth": "1.7.14",
    "drizzle-kit": "1.0.0-rc.5",
    "eslint": "^10.13.0",
    "h3": "2.0.8",
    "h3-next": "npm:h3@2.0.8",
    "happy-dom": "^21.0.4",
    "jiti": "^2.7.0",
    "nitro": "3.0.260903-nightly",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.1.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.13"
  }
}
