{
  "name": "package-name",
  "type": "module",
  "version": "0.0.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.0.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.20.0",
      "onFail": "download"
    }
  },
  "description": "",
  "license": "MIT",
  "repository": "Teages/repo",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*"
    },
    "./utils/*": {
      "types": "./dist/utils/*.d.mts",
      "default": "./dist/utils/*.mjs"
    },
    "./composables/*": {
      "types": "./dist/composables/*.d.mts",
      "default": "./dist/composables/*.mjs"
    },
    "./unplugin": {
      "types": "./dist/unplugin.d.mts",
      "default": "./dist/unplugin.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "default": "./dist/vite.mjs"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.mts",
      "default": "./dist/nuxt.mjs"
    },
    "./styles": "./dist/styles/index.css"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -C playground dev",
    "dev:nuxt": "pnpm -C playground-nuxt dev:dist",
    "dev:dist": "pnpm -C playground dev:dist",
    "dev:dist:nuxt": "pnpm -C playground-nuxt dev:dist",
    "codegen": "jiti ./scripts/codegen.ts",
    "build": "pnpm codegen && tsdown",
    "prepack": "pnpm build",
    "release": "pnpm test && changelogen --release --push && pnpm publish",
    "test": "pnpm lint && pnpm test:types && vitest run --coverage",
    "test:types": "vue-tsc --noEmit --skipLibCheck",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix ."
  },
  "peerDependencies": {
    "vue": "^3.5"
  },
  "dependencies": {
    "@nuxt/kit": "^4.6.4",
    "@nuxt/schema": "^4.6.4",
    "defu": "^6.1.7",
    "local-pkg": "^2.0.0",
    "pathe": "^2.0.3",
    "unimport": "^7.0.2",
    "unplugin": "^3.7.0",
    "unplugin-vue-components": "^32.1.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.0",
    "@volar/typescript": "^2.4.31",
    "@vue/test-utils": "^2.5.1",
    "changelogen": "^0.6.2",
    "eslint": "^10.14.0",
    "happy-dom": "^21.0.4",
    "jiti": "^2.7.0",
    "knitwork": "^1.3.0",
    "mlly": "^1.8.2",
    "sass": "^1.108.2",
    "scule": "^1.3.0",
    "tinyglobby": "^0.2.17",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-sfc-transformer": "^0.3.3",
    "vue-tsc": "^3.3.14"
  },
  "publishConfig": {
    "access": "public"
  }
}
