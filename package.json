{
  "name": "apps",
  "version": "0.0.0",
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "dev": "pnpm --filter ./frontend dev",
    "dev:mock": "pnpm --filter ./frontend dev:mock",
    "lint": "eslint && pnpm -r lint",
    "lint:fix": "eslint --fix && pnpm -r lint:fix",
    "test": "pnpm --filter ./frontend test:unit && pnpm --filter ./frontend test:nuxt",
    "skills:install": "skills experimental_install --agent universal",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.1.0",
    "eslint": "^10.7.0",
    "jiti": "^2.7.0",
    "skills": "^1.5.17"
  }
}
