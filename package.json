{
  "name": "app",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "jiti ./scripts/prepare.ts",
    "dev": "pnpm dev:mock",
    "dev:mock": "MOCK_DATABASE=true vite dev",
    "dev:prod": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "pnpm prepare && vue-tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest run",
    "test:watch": "vitest --project unit",
    "test:unit": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "auth:generate": "better-auth generate --config ./server/utils/auth.ts --output ./server/database/auth.ts",
    "skills:install": "skills experimental_install --agent universal",
    "task:db:migrate": "curl -sf -X POST 'http://localhost:20398/_nitro/tasks/db:migrate'",
    "task:db:reset": "curl -sf -X POST 'http://localhost:20398/_nitro/tasks/db:reset'",
    "schema:update": "jiti ./scripts/prepare.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.0-rc.4",
    "@nuxt/ui": "^4.10.0",
    "@pothos/core": "4.13.1",
    "@pothos/plugin-drizzle": "0.17.5",
    "@pothos/plugin-relay": "4.7.1",
    "@pothos/plugin-simple-objects": "4.1.4",
    "@pothos/plugin-with-input": "4.1.5",
    "@teages/oh-my-graphql": "^0.1.4",
    "better-auth": "1.7.0-rc.4",
    "consola": "^3.4.2",
    "devalue": "^5.9.0",
    "drizzle-orm": "1.0.0-rc.4",
    "gazania": "^0.15.4",
    "graphql": "^16.14.2",
    "graphql-yoga": "5.21.2",
    "ofetch": "^1.5.1",
    "postgres": "^3.4.9",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.2.0",
    "@better-auth/test-utils": "1.7.0-rc.4",
    "@electric-sql/pglite": "^0.5.4",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.0",
    "@vitejs/devtools": "^0.4.12",
    "@vitejs/devtools-kit": "^0.4.12",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.1",
    "auth": "1.7.0-rc.4",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^10.7.0",
    "get-port-please": "^3.2.0",
    "jiti": "^2.7.0",
    "nitro": "3.0.260603-beta",
    "skills": "^1.5.17",
    "typescript": "^5.9.2",
    "unhead": "^2.1.12",
    "vite": "^8.2.0",
    "vite-plugin-devtools-json": "^1.0.0",
    "vitest": "^4.1.10",
    "vue": "^3.5.31",
    "vue-router": "^5.0.4",
    "vue-tsc": "^3.3.9"
  }
}
