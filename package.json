{
  "name": "package-name",
  "type": "module",
  "version": "0.0.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.0.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.20.0",
      "onFail": "download"
    }
  },
  "description": "",
  "license": "MIT",
  "repository": "git+https://github.com/Teages/repo.git",
  "sideEffects": [
    "./dist/styles/*",
    "./src/styles/*"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./components/*": "./src/components/*",
    "./utils/*": "./src/utils/*.ts",
    "./composables/*": "./src/composables/*.ts",
    "./unplugin": "./src/unplugin.ts",
    "./vite": "./src/vite.ts",
    "./nuxt": "./src/nuxt.ts",
    "./styles": "./src/styles/index.ts"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -C playground dev",
    "dev:nuxt": "pnpm -C playground-nuxt dev",
    "codegen": "node ./scripts/codegen.ts",
    "build": "pnpm codegen && tsdown",
    "prepack": "pnpm build",
    "test": "vitest run --coverage",
    "typecheck": "tsc --runExternalCode",
    "lint": "eslint",
    "fmt": "eslint --fix"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@nuxt/kit": "^4.6.4",
    "@nuxt/schema": "^4.6.4",
    "defu": "^6.1.7",
    "unimport": "^7.0.2",
    "unplugin": "^3.7.0",
    "unplugin-vue-components": "^32.1.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@arethetypeswrong/core": "^0.18.5",
    "@tsdown/css": "^0.23.7",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@7.1.0-beta",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/content-mapper": "4.0.0-alpha.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "happy-dom": "^21.0.4",
    "mlly": "^1.8.2",
    "pathe": "^2.0.3",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-sfc-transformer": "^0.3.3",
    "vue-tsc": "^3.3.14"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.mjs",
      "./components/*": "./dist/components/*",
      "./utils/*": "./dist/utils/*.mjs",
      "./composables/*": "./dist/composables/*.mjs",
      "./unplugin": "./dist/unplugin.mjs",
      "./vite": "./dist/vite.mjs",
      "./nuxt": "./dist/nuxt.mjs",
      "./styles": "./dist/styles/index.mjs"
    }
  }
}
