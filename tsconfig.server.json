{
  "extends": "nitro/tsconfig",
  "compilerOptions": {
    "rootDir": ".",
    "paths": {
      "~/*": ["./*"],
      "#generated/*": ["./.generated/*"]
    },
    "types": ["node", "vite/client", "nitro/vite/types"],
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "env.d.ts",
    ".generated/server/**/*.ts",
    ".generated/shared/**/*.ts",
    "server/**/*.ts",
    "test/e2e/app/**/*.ts",
    "test/e2e/api/**/*.ts",
    "test/setup.ts",
    "test/utils.ts"
  ]
}
