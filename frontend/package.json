{
  "name": "nuxt-app",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "build:test": "nuxt build",
    "dev": "TMPDIR=/tmp nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "validate:schema": "node --input-type=module -e \"import { readFileSync } from 'node:fs'; import { parse } from 'graphql'; parse(readFileSync(new URL('../backend/server/graphql/schema.graphql', import.meta.url), 'utf8'))\"",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:nuxt": "vitest run --project nuxt",
    "test:browser": "pnpm run build:test && playwright test",
    "test:browser:ui": "pnpm run build:test && playwright test --ui"
  },
  "dependencies": {
    "@vueuse/core": "^14.3.0",
    "better-auth": "1.7.0-rc.1",
    "es-toolkit": "^1.49.0",
    "gazania": "^0.15.4",
    "graphql": "^16.14.1",
    "nuxt": "npm:nuxt-nightly@5.0.0-29743829.e99b20d2",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.1.0",
    "@iconify-json/lucide": "^1.2.118",
    "@iconify-json/simple-icons": "^1.2.91",
    "@nuxt/eslint": "1.16.0",
    "@nuxt/icon": "^2.3.1",
    "@nuxt/test-utils": "^4.0.3",
    "@nuxt/ui": "4.9.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "@vueuse/nuxt": "^14.3.0",
    "eslint": "^10.7.0",
    "nitro": "3.0.260610-beta",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.0.0",
    "vitest": "^4.1.10"
  }
}
