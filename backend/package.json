{
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "pnpm dev:mock",
    "dev:mock": "MOCK_DATABASE=true vite dev",
    "dev:prod": "vite dev",
    "preview": "vite preview",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "auth:generate": "better-auth generate --config ./server/utils/auth.ts --output ./server/database/auth.ts",
    "test": "vitest --run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "task:db:migrate": "curl -sf -X POST 'http://localhost:20398/_nitro/tasks/db:migrate'",
    "task:db:reset": "curl -sf -X POST 'http://localhost:20398/_nitro/tasks/db:reset'",
    "task:auth:login": "curl -sf -X POST 'http://localhost:20398/_nitro/tasks/auth:login' -H 'Content-Type: application/json' -d '{}'",
    "task:auth:seed-e2e-user": "curl -sf -X POST 'http://localhost:20398/_nitro/tasks/auth:seed-e2e-user'",
    "schema:update": "sh -lc 'pnpm exec vite dev & pid=$!; sleep 8; kill $pid 2>/dev/null; wait $pid 2>/dev/null; true'"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.0-rc.1",
    "@pothos/core": "4.13.1",
    "@pothos/plugin-drizzle": "0.17.5",
    "@pothos/plugin-relay": "4.7.1",
    "@pothos/plugin-simple-objects": "4.1.4",
    "@pothos/plugin-with-input": "4.1.5",
    "@teages/oh-my-graphql": "^0.1.4",
    "better-auth": "1.7.0-rc.1",
    "consola": "^3.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "gazania": "^0.15.4",
    "graphql": "^16.14.1",
    "graphql-yoga": "5.21.2",
    "ofetch": "^1.5.1",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@better-auth/test-utils": "1.7.0-rc.1",
    "@electric-sql/pglite": "^0.5.4",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.10",
    "auth": "1.7.0-rc.1",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^10.7.0",
    "jiti": "^2.7.0",
    "nitro": "3.0.260603-beta",
    "typescript": "^6.0.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
